rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 기본: 모든 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // profiles: 본인 문서만 읽기/쓰기/삭제
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // characters: 본인 문서만 읽기/쓰기
    match /characters/{characterId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // mood_entries: 본인 문서만 읽기/쓰기/삭제
    match /mood_entries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // attendance: 본인 출석 기록만 읽기/생성/수정 (삭제 불가)
    match /attendance/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // rewards: 본인 보상 기록만 읽기/쓰기 (삭제 불가)
    match /rewards/{userId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow write: if request.auth != null && userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
